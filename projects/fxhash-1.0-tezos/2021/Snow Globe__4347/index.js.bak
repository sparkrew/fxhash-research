// these are the variables you can use as inputs to your algorithms
// console.log(fxhash)   // the 64 chars hex number fed to your algorithm
// console.log(fxrand()) // deterministic PRNG function, use it instead of Math.random()

// note about the fxrand() function 
// when the "fxhash" is always the same, it will generate the same sequence of
// pseudo random numbers, always

//----------------------
// defining features
//----------------------
// You can define some token features by populating the $fxhashFeatures property
// of the window object.
// More about it in the guide, section features:
// [https://fxhash.xyz/articles/guide-mint-generative-token#features]


// set circle color feature
function FeatGlobe() {
	var value = fxrand(); // get random value
	if (value < 0.06) return "Holly";
	if (value < 0.1) return "Glass";
	if (value < 0.2) return "Gold";
	if (value < 0.4) return "Green";
	if (value < 0.5) return "Black";
	if (value < 0.6) return "Red";
	if (value < 0.8) return "Wood";
	else return "Metal";
}
function FeatCharacter() {
	var value = fxrand(); // get random value
	if (value < 0.06) return "Yeti";
	if (value < 0.1) return "PolarBear";
	if (value < 0.2) return "Elf";
	if (value < 0.4) return "Santa";
	if (value < 0.5) return "Penguin";
	if (value < 0.6) return "Fox";
	if (value < 0.8) return "Deer";
	else return "Snowman";
}
function FeatCenter() {
	var value = fxrand(); // get random value
	if (value < 0.06) return "SnowPenis";
	if (value < 0.1) return "Cabin";
	if (value < 0.2) return "HouseRed";
	if (value < 0.4) return "Present";
	if (value < 0.5) return "HouseBlue";
	if (value < 0.6) return "City";
	if (value < 0.8) return "Mountain";
	else return "Tree";
}

function FeatTree() {
	var value = fxrand(); // get random value
	if (value < 0.06) return "XmasFir";
	if (value < 0.1) return "XmasOak";
	if (value < 0.2) return "FirIce";
	if (value < 0.4) return "FirSnow";
	if (value < 0.5) return "Stump";
	if (value < 0.6) return "FirSnowTop";
	if (value < 0.8) return "Oak";
	else return "Fir";
}



// features
window.$fxhashFeatures = {
	"Globe" : FeatGlobe(),
	"Character" : FeatCharacter(),
	"Center" : FeatCenter(),
	"Tree" : FeatTree(),
}



