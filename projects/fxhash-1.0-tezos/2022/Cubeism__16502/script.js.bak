palettes = [
    {
        'bg': '#d0ecf0',
        'box': {
            'bg': ['#f50062', '#00d0f5', '#2b2b2b', '#f5f201'],
            'fg': ['#f50062', '#00d0f5', '#2b2b2b', '#f5f201']
        }
    },
];

let selectPalette = [];
let translateX = 0;
let translateY = 0;

function preload() {
    tFont = loadFont('assets/arial.ttf');

    let c = 1;
    for (let i = 1; i <= 9; i++) {
        imgBlends[c - 1] = loadImage('assets/t' + i + '.png');
        c++;
    }


    c = 1;
    for (let i = 1; i <= 6; i++) {
        for (let y = 1; y <= 6; y++) {
            img[c - 1] = {
                "id": i,
                "img": loadImage('assets/' + i + '.png')
            };
            c++;
        }
    }
}

function setup() {
    randomSeed(int(fxrand() * 987654321));
    noLoop();
    imageMode(CENTER);
    angleMode(DEGREES);
    frameRate(1);

    canvas = createCanvas(1080, 1080);
    canvas.position(0, 0);
    canvas.style('z-index', '-3');
    extraCanvas = createGraphics(1080, 1080, WEBGL);
    extraCanvas.clear();
}

function draw() {
    selectPalette = random(palette);

    //console.log(palette);
    //console.log(selectPalette);

    bg = selectPalette.bg;
    background(bg);
    shuffle(img, true);
    img.forEach(imageLoop);
    lineLoop(4);
    fillChar('+');

    imageMode(CENTER);
    translate (width/2, height/2);
    rotate(random([0,90,180,270]));
    imgBlend = random(imgBlends);

    blend(imgBlend, 0, 0, 1080, 1080, -540, -540, 1080, 1080, MULTIPLY);

}

function imageLoop(sourceImg) {
    boxBg = random(selectPalette.box.bg);
    boxFg = random(selectPalette.box.fg);
    scale = random(3, 26);
    angle = random(0, 360);

    translateX = random(-280, 280);
    translateY = random(-280, 280);

    extraCanvas.push();

    extraCanvas.clear();
    extraCanvas.translate(translateX, translateY, 0);
    extraCanvas.rotateX(angle);
    extraCanvas.rotateY(angle);
    extraCanvas.rotateZ(angle);

    extraCanvas.fill(boxBg);
    extraCanvas.box(width / scale);

    extraCanvas.texture(sourceImg.img);
    extraCanvas.tint(boxFg);
    extraCanvas.box(width / scale);

    image(extraCanvas, width / 2, height / 2);

    extraCanvas.pop();

}

function lineLoop(lineCount) {
    let fg = selectPalette.box.bg.concat(['#ffffff', '#000000']);

    for (let i = 1; i <= lineCount; i++) {

        scale = random(3, 24);
        angle = random(0, 360);

        extraCanvas.translateX = random(-280, 280);
        extraCanvas.translateY = random(-280, 280);

        extraCanvas.push();

        extraCanvas.translate(translateX, translateY, 0);
        extraCanvas.rotateX(angle);
        extraCanvas.rotateY(angle);
        extraCanvas.rotateZ(angle);

        extraCanvas.noStroke();
        extraCanvas.fill(random(fg));

        extraCanvas.cylinder(1, 10000);

        image(extraCanvas, width / 2, height / 2);

        extraCanvas.pop();

    }
}

function fillChar(tChars) {
    let fg = selectPalette.box.bg.concat(['#ffffff', '#000000']);
    let textX = -800;
    let textY = -800;

    extraCanvas.textFont(tFont);

    for (let x = 0; x <= 2; x++) {
        for (let y = 0; y <= 2; y++) {
            extraCanvas.fill(random(fg));
            let tTextSize = random(24, 100);
            extraCanvas.textSize(tTextSize);
            extraCanvas.text(tChars, textX + (x + 1) * random(300, 450), textY + (y + 1) * random(300, 450));
        }
    }

    image(extraCanvas, width / 2, height / 2);
}