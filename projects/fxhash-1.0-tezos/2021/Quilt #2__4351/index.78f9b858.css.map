* {
  box-sizing: border-box;
}

body {
  position: relative;
  overflow: hidden;
  user-select: none;
  background-image: linear-gradient(120deg, #fdfbfb 0%, #ebedee 100%);
}

#art {
  position: relative;
  display: grid;
  justify-content: center;
  align-content: center;
  width: 100vw;
  height: 100vh;
}
#art #canvas {
  background: white;
  box-shadow: 0 1px 6px rgba(0, 0, 0, 0.05), 4px 32px 32px rgba(0, 0, 0, 0.05), 8px 50px 64px rgba(0, 0, 0, 0.15);
}

#preloader {
  position: absolute;
  top: 0;
  left: 0;
  margin: 0;
  padding: 0;
  display: grid;
  justify-content: center;
  align-content: center;
  width: 100vw;
  height: 100vh;
  z-index: 2;
  background-color: rgba(0, 0, 0, 0.5);
}
#preloader p {
  font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 1.25rem;
  font-style: normal;
  font-variant: normal;
  font-weight: 400;
  line-height: 20px;
  color: white;
  text-shadow: 0 1px 6px rgba(0, 0, 0, 0.05), 4px 32px 32px rgba(0, 0, 0, 0.05), 8px 50px 64px rgba(0, 0, 0, 0.15);
}

#notes {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  display: grid;
  grid-template-columns: 1fr auto auto;
  background: transparent;
  padding: 0.75rem 1rem;
  user-select: text;
  font-size: 0.75rem;
  line-height: 1.3rem;
  font-family: sans-serif;
  color: #666 !important;
  z-index: 2;
}
#notes #note {
  margin: 0;
}
#notes #download, #notes #record {
  color: #666;
  text-decoration: none;
  margin-left: 1rem;
}
